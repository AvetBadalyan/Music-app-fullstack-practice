# ─── Supabase (public keys — safe to expose in the browser) ──────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# ─── API ─────────────────────────────────────────────────────────────────────
# Only needed in production when the frontend is deployed separately.
# In development the Vite proxy forwards /api/* to localhost:3000.
# VITE_API_URL=https://your-backend.onrender.com

# ─── Auth ────────────────────────────────────────────────────────────────────
# Controls UI visibility of admin actions (create / delete buttons).
# The backend enforces the real restriction via ADMIN_EMAIL.
VITE_ADMIN_EMAIL=admin@example.com
