# ─── Database ────────────────────────────────────────────────────────────────
# Option A: single connection URL. Set this on the host (Vercel / Railway etc.).
# Leave it unset locally: it takes priority over the fields below, so a stray
# value here points your dev server at the deployed database.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Option B: individual fields (used locally, when DATABASE_URL is unset)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=yourpassword
DB_NAME=music_app

# ─── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-key

# Storage bucket names (create these in your Supabase project)
SUPABASE_SONGS_BUCKET=songs
SUPABASE_ALBUM_COVERS_BUCKET=album-covers
SUPABASE_ARTIST_IMAGES_BUCKET=artist-images

# ─── Auth ────────────────────────────────────────────────────────────────────
# The email address that receives admin write access
ADMIN_EMAIL=admin@example.com

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
# Allowed browser origin for CORS (no trailing slash)
CLIENT_URL=http://localhost:5173

# ─── TypeORM (dev only) ──────────────────────────────────────────────────────
# Set to "true" locally to auto-sync the schema.
# NEVER set to "true" in production — it can DROP columns.
DB_SYNCHRONIZE=true
DB_LOGGING=true
